# ==============================================================================
# HealthShield AI — Environment Configuration Template
# Copy this file to .env and fill in your production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Neon PostgreSQL (Production on AWS):
# Copy your connection string directly from the Neon.tech dashboard:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# For Local SQLite (Default fallback if DATABASE_URL is unset):
DATABASE_URL=sqlite:///./healthshield.db

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, generate a strong random 32+ character string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Default administrator account password when the database is initially seeded
# Default email: admin@healthshield.ai
DEV_ADMIN_PASSWORD=AdminSafePass123!

# ------------------------------------------------------------------------------
# 3. AI HEALTH ASSISTANT (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Gemini API Key for dynamic health query responses
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. OUTBOUND EMAIL NOTIFICATIONS / REAL OTP DISPATCH (OPTIONAL)
# ------------------------------------------------------------------------------
# When configured, real 6-digit OTP verification emails will be sent
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & STORAGE
# ------------------------------------------------------------------------------
# Server port (Defaults to 8000; AWS App Runner / Elastic Beanstalk injects this)
PORT=8000

# File upload directory for encrypted/private medical reports
STORAGE_DIR=backend/storage/reports
